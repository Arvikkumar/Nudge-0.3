<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".GentleNudgeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GentleNudge">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for offline PDF export and attachments sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Alarm and Notification Receiver -->
        <receiver
            android:name=".notification.NudgeNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.gentlenudge.ACTION_FIRE_NUDGE" />
                <action android:name="com.example.gentlenudge.ACTION_MARK_DONE" />
                <action android:name="com.example.gentlenudge.ACTION_SNOOZE_NUDGE" />
                <action android:name="com.example.gentlenudge.ACTION_FIRE_EVENT_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Boot and Timezone Receiver for Alarm Rescheduling -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Backup & Data Safety Receiver for Automatic Backups -->
        <receiver
            android:name=".backup.NudgeBackupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.gentlenudge.ACTION_TRIGGER_AUTO_BACKUP" />
            </intent-filter>
        </receiver>

        <!-- Nudge Analog Clock Home-Screen Widget -->
        <receiver
            android:name=".widget.NudgeClockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.gentlenudge.ACTION_UPDATE_CLOCK_WIDGET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nudge_clock_widget_info" />
        </receiver>

        <!-- Nudge Deep Dive Home-Screen Widget -->
        <receiver
            android:name=".widget.DeepDiveWidgetProvider"
            android:exported="true"
            android:label="@string/widget_deep_dive_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.gentlenudge.ACTION_START_DEEP_DIVE_30" />
                <action android:name="com.example.gentlenudge.ACTION_START_DEEP_DIVE_60" />
                <action android:name="com.example.gentlenudge.ACTION_STOP_DEEP_DIVE" />
                <action android:name="com.example.gentlenudge.ACTION_UPDATE_DEEP_DIVE_WIDGET" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nudge_deep_dive_widget_info" />
        </receiver>
    </application>

</manifest>
