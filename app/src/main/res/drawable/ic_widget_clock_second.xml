<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="2000dp"
    android:height="2000dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Second Hand with Counter-Tail (Tip = 71 units, Tail = 11 units, stroke = 0.85 units, #3B82F6 @ 0.65 opacity = #A63B82F6) -->
    <path
        android:strokeColor="#A63B82F6"
        android:strokeWidth="0.85"
        android:strokeLineCap="round"
        android:pathData="M 100,111 L 100,29" />

    <!-- Center Pivot Dot (Radius = 2.2 units, #3B82F6 @ 0.70 opacity = #B33B82F6) drawn on top of hands -->
    <path
        android:fillColor="#B33B82F6"
        android:pathData="M 100,100 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />

</vector>
