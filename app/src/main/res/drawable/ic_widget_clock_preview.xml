<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- 1. Blue Progress Ring (radius 85, sweep from 12 o'clock to ~10 past / 60 degrees) -->
    <path
        android:strokeColor="#8A3B82F6"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 100,15 A 85,85 0 0,1 173.61,57.5" />

    <!-- 2. 12 Tick Marks (Outer radius 72, Inner radius 64, stroke 1.3, color #918E8E93) -->
    <!-- 12 o'clock -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 100,36 L 100,28" />
    <!-- 1 o'clock (30 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 132.00,44.55 L 136.00,37.63" />
    <!-- 2 o'clock (60 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 155.43,68.00 L 162.35,64.00" />
    <!-- 3 o'clock (90 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 164,100 L 172,100" />
    <!-- 4 o'clock (120 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 155.43,132.00 L 162.35,136.00" />
    <!-- 5 o'clock (150 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 132.00,155.43 L 136.00,162.35" />
    <!-- 6 o'clock (180 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 100,164 L 100,172" />
    <!-- 7 o'clock (210 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 68.00,155.43 L 64.00,162.35" />
    <!-- 8 o'clock (240 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 44.57,132.00 L 37.65,136.00" />
    <!-- 9 o'clock (270 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 36,100 L 28,100" />
    <!-- 10 o'clock (300 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 44.57,68.00 L 37.65,64.00" />
    <!-- 11 o'clock (330 deg) -->
    <path
        android:strokeColor="#918E8E93"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:pathData="M 68.00,44.55 L 64.00,37.63" />

    <!-- 3. Hour Hand (length 50, stroke 1.8, color #A68E8E93, pointing at ~10:10 / -60 deg) -->
    <path
        android:strokeColor="#A68E8E93"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M 100,100 L 75.0,56.7" />

    <!-- 4. Minute Hand (length 70, stroke 1.2, color #998E8E93, pointing at ~10 min / 60 deg) -->
    <path
        android:strokeColor="#998E8E93"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M 100,100 L 160.62,65.0" />

    <!-- 5. Second Hand (tip 71, tail 11, stroke 0.85, color #A63B82F6, pointing up/sec 0) -->
    <path
        android:strokeColor="#A63B82F6"
        android:strokeWidth="0.85"
        android:strokeLineCap="round"
        android:pathData="M 100,111 L 100,29" />

    <!-- 6. Center Pivot Dot (radius 2.2, color #B33B82F6) -->
    <path
        android:fillColor="#B33B82F6"
        android:pathData="M 100,100 m -2.2,0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0" />
