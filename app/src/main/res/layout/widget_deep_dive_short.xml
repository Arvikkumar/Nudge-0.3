<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_deep_dive_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_deep_dive_card"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- ============================================== -->
    <!-- IDLE STATE (Short layout)                      -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/widget_deep_dive_idle_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header: Title on left, Settings ⚙ on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_deep_dive_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DEEP DIVE"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Configuration affordance button (Settings ⚙) -->
            <FrameLayout
                android:id="@+id/widget_idle_btn_config"
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="Deep Dive Settings" />
            </FrameLayout>
        </LinearLayout>

        <!-- Balanced spacer above controls -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Middle Controls Row: [ 30 min ] [ 1 hour ]       [ ▶ ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_30min"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_widget_pill_button"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:text="30 min"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_1hour"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_widget_pill_button"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:text="1 hour"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Circular Quick-Start Play Button -->
            <FrameLayout
                android:id="@+id/widget_btn_quick_play"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_widget_circle_blue">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="1dp"
                    android:src="@drawable/ic_widget_play"
                    android:contentDescription="Start Deep Dive" />
            </FrameLayout>
        </LinearLayout>

        <!-- Balanced spacer below controls -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hairline Divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_widget_divider" />

        <!-- Bottom Information Row: 🔔 Reminders Count and ♪ Notification Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_idle_reminders_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingRight="4dp"
                android:text="🔔 No reminders"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_idle_sound_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:paddingLeft="4dp"
                android:text="♪ One Shot"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================== -->
    <!-- ACTIVE STATE (Short layout)                    -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/widget_deep_dive_active_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header: Title & Active Badge on left, Settings ⚙ on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEEP DIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_active_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_widget_active_badge"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="Active"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Configuration affordance button (Settings ⚙) -->
            <FrameLayout
                android:id="@+id/widget_active_btn_config"
                android:layout_width="28dp"
                android:layout_height="28dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_settings"
                    android:contentDescription="Deep Dive Settings" />
            </FrameLayout>
        </LinearLayout>

        <!-- Balanced spacer above countdown -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Middle Row: Chronometer Countdown + End Time on left, Stop Button on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Chronometer
                    android:id="@+id/widget_active_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#2E62F6"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_active_end_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ends at --:--"
                    android:textColor="#F0EDE8"
                    android:textSize="10.5sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Stop Action Button -->
            <FrameLayout
                android:id="@+id/widget_btn_stop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_widget_circle_blue">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_stop"
                    android:contentDescription="Stop Deep Dive" />
            </FrameLayout>
        </LinearLayout>

        <!-- Balanced spacer below countdown -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hairline Divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_widget_divider" />

        <!-- Bottom Information Row (Active): 🔔 Reminders Count and ♪ Notification Style -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_active_reminders_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:paddingRight="4dp"
                android:text="🔔 No reminders"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_active_sound_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:paddingLeft="4dp"
                android:text="♪ One Shot"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
